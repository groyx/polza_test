# секреты
.env

# личные черновики, не часть сдачи
_черновик_*.md

# кэш скачанных страниц — большой и машинозависимый
data/cache/*
# ...а вот кэш ответов модели коммитим намеренно: он позволяет запустить
# скрипт без ключей и без интернета и получить тот же результат.
!data/cache/llm/

# python
__pycache__/
*.py[cod]
.venv/
venv/

# ос
.DS_Store
Thumbs.db
